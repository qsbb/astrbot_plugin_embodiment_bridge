{
  "protocol_version": "1.0",
  "base_path": "/api/v1/plugins/extensions/astrbot_plugin_quest_avatar_bridge",
  "authentication_headers": [
    "Authorization",
    "X-Quest-Avatar-Key"
  ],
  "audio": {
    "input": {
      "format": "pcm16",
      "byte_order": "little_endian",
      "sample_rate": 16000,
      "channels": 1,
      "sample_width_bytes": 2,
      "recommended_chunk_ms": {"minimum": 40, "maximum": 100},
      "sequence_first": 0,
      "sequence_step": 1
    },
    "output": {
      "format": "pcm16",
      "byte_order": "little_endian",
      "sample_rate": 24000,
      "channels": 1,
      "sample_width_bytes": 2,
      "encoding": "base64_in_sse_data"
    }
  },
  "routes": [
    {"method": "GET", "path": "/pairing/service-status", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "POST", "path": "/pairing/service-control", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "POST", "path": "/pairing/listener-port", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "GET", "path": "/pairing/overview", "success_status": 200, "authentication": "astrbot_dashboard"},
      {"method": "GET", "path": "/pairing/operator-settings", "success_status": 200, "authentication": "astrbot_dashboard"},
      {"method": "POST", "path": "/pairing/operator-settings", "success_status": 200, "authentication": "astrbot_dashboard"},
      {"method": "GET", "path": "/pairing/platform-settings", "success_status": 200, "authentication": "astrbot_dashboard"},
      {"method": "POST", "path": "/pairing/platform-settings", "success_status": 200, "authentication": "astrbot_dashboard"},
      {"method": "GET", "path": "/pairing/persona-settings", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "POST", "path": "/pairing/persona-settings", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "GET", "path": "/pairing/quest-identity-settings", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "POST", "path": "/pairing/quest-identity-settings", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "GET", "path": "/pairing/diagnostics", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "GET", "path": "/pairing/identity-candidates", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "POST", "path": "/pairing/identity-selection", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "GET", "path": "/pairing/api-principal-proof", "success_status": 200, "authentication": "astrbot_api_key_plugin_scope"},
    {"method": "POST", "path": "/pairing/create", "success_status": 201, "authentication": "astrbot_dashboard"},
    {"method": "POST", "path": "/pairing/status", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "POST", "path": "/pairing/revoke", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "POST", "path": "/pairing/exchange", "success_status": 200, "authentication": "reverse_proxy_plugin_scope+one_time_pairing_credential"},
    {"method": "POST", "path": "/session/start", "success_status": 201},
    {"method": "GET", "path": "/events/<session_id>", "success_status": 200},
    {"method": "POST", "path": "/turn/start", "success_status": 202},
    {"method": "POST", "path": "/audio/chunk", "success_status": 202},
    {"method": "POST", "path": "/audio/end", "success_status": 202},
    {"method": "POST", "path": "/interaction", "success_status": 202},
    {"method": "POST", "path": "/interrupt", "success_status": 200},
    {"method": "POST", "path": "/session/close", "success_status": 200},
    {"method": "GET", "path": "/health", "success_status": 200}
  ],
  "enums": {
    "emotion": [
      "neutral",
      "happy",
      "shy",
      "surprised",
      "concerned",
      "uncomfortable"
    ],
    "gesture": [
      "idle",
      "talk",
      "wave",
      "bow",
      "handshake",
      "head_pat",
      "cheek_pinch",
      "refuse",
      "step_back",
      "dance",
      "nod",
      "sway"
    ],
    "look_at": ["user", "hand", "away", "none"],
    "interaction_name": [
      "handshake",
      "head_pat",
      "cheek_pinch",
      "gaze",
      "speaking"
    ],
    "interaction_phase": ["start", "update", "end", "cancel"],
    "hand": ["left", "right", "both", "none"]
  },
  "event_order": {
    "speech_success": [
      "asr.final",
      "avatar.intent",
      "reply.text.delta",
      "reply.audio.chunk",
      "reply.end"
    ],
    "text_success": [
      "avatar.intent",
      "reply.text.delta",
      "reply.audio.chunk",
      "reply.end"
    ],
    "interaction_success": [
      "avatar.intent",
      "reply.text.delta",
      "reply.audio.chunk",
      "reply.end"
    ],
    "stt_unavailable": ["error"],
    "stt_failed": ["error"],
    "tts_failed_after_text": [
      "avatar.intent",
      "reply.text.delta",
      "error",
      "reply.end"
    ],
    "turn_failed": [
      "error",
      "reply.end"
    ],
    "interaction_failed": [
      "error",
      "reply.end"
    ]
  },
  "unity_conversation_controller": {
    "text_max_characters": 8192,
    "audio_turn_text_forms_accepted": ["omitted", "null", "empty_string"],
    "recommended_capture_chunk_ms": 80,
    "recommended_capture_chunk_bytes": 2560,
    "input_sequence_first": 0,
    "input_sequence_step": 1,
    "interrupt_before_new_turn": true,
    "stale_events_after_interrupt_ack": "discard_by_session_and_turn"
  },
  "critical_events": [
    "asr.final",
    "avatar.intent",
    "reply.audio.chunk",
    "reply.end",
    "error"
  ],
  "droppable_events": [
    "asr.partial",
    "reply.text.delta"
  ],
  "interrupt_semantics": {
    "forbidden_after_interrupt_ack": [
      "asr.partial",
      "asr.final",
      "reply.text.delta",
      "reply.audio.chunk",
      "avatar.intent",
      "reply.end",
      "error"
    ]
  },
  "backpressure_semantics": {
    "bounded_per_session_queue": true,
    "asr_partial_coalesced_per_turn": true,
    "droppable_when_full": [
      "asr.partial",
      "reply.text.delta"
    ],
    "never_dropped_to_admit_noncritical": [
      "asr.final",
      "avatar.intent",
      "reply.audio.chunk",
      "reply.end",
      "error"
    ],
    "critical_producer_waits_when_only_critical_events_remain": true
  },
  "reconnect_semantics": {
    "max_streams_per_session": 1,
    "last_event_id_replay": false,
    "already_consumed_events_replayed": false,
    "queued_unconsumed_critical_events_retained": true
  },
  "session_start_semantics": {
    "same_owner_and_identity_is_idempotent_and_reauthorized": true,
    "identity_change_for_existing_session_is_conflict": true,
    "protected_context_status_in_response": true,
    "protected_context_default_access": "denied",
    "api_principal_source": "astrbot_authenticated_request",
    "trusted_client_id_source": "bridge_server_config",
    "trusted_platform_id_source": "bridge_server_config",
    "unity_trusted_source_fields": false
  },
  "pairing_bootstrap_semantics": {
    "register_web_api_anonymous_supported": false,
    "page_create_authentication": "astrbot_dashboard",
    "exchange_core_authentication": "reverse_proxy_plugin_scope",
    "exchange_credential": "single_use_token_or_six_digit_code",
    "expected_remote_ip_bound_per_session": true,
    "per_source_rate_limit": true,
    "global_rate_limit": true,
    "private_http_requires_server_and_session_opt_in": true,
    "public_network_requires_https": true
  },
  "series_integration_semantics": {
    "knowledge_scope": "global_only",
    "relationship_requires_identity_authorization": true,
    "environment_mode": "cached_only",
    "voice_contract": "voice.audio_output@1.0",
    "runtime_refresh": "startup_and_explicit_health",
    "conversation_proactive_delivery_consumed": false,
    "orchestration_hub_resolver_consumed": false
  },
  "sse_error_codes": [
    "stt_empty",
    "stt_unavailable",
    "stt_failed",
    "astrbot_pipeline_not_woken",
    "astrbot_pipeline_event_stopped",
    "astrbot_pipeline_reply_capture_empty",
    "astrbot_pipeline_no_response",
    "astrbot_pipeline_empty_reply",
    "turn_failed",
    "interaction_failed",
    "tts_failed",
    "owner_not_configured",
    "quest_identity_not_allowlisted",
    "trusted_platform_not_configured"
  ],
  "http_error_codes": [
    {"status": 400, "code": "invalid_content_length"},
    {"status": 400, "code": "empty_body"},
    {"status": 400, "code": "invalid_audio"},
    {"status": 401, "code": "astrbot_auth_required"},
    {"status": 401, "code": "bridge_auth_failed"},
    {"status": 403, "code": "session_ownership_mismatch"},
    {"status": 404, "code": "session_not_found"},
    {"status": 409, "code": "session_conflict"},
    {"status": 413, "code": "payload_too_large"},
    {"status": 415, "code": "unsupported_media_type"},
    {"status": 422, "code": "schema_validation_failed"},
    {"status": 500, "code": "internal_error"},
    {"status": 503, "code": "bridge_not_configured"}
    ,{"status": 503, "code": "bridge_service_disabled"}
  ]
}
