{
  "protocol_version": "1.0",
  "optional_extensions": {
    "server_timing@1.0": {
      "enabled_by": "server_timing_enabled",
      "location": "reply.end.server_timing",
      "default_present": false,
      "decision_path": ["astrbot_event_bus", "direct_provider"],
      "duration_fields": [
        "stt_ms",
        "decision_ms",
        "tts_first_chunk_ms",
        "tts_total_ms",
        "turn_total_ms"
      ],
      "duration_unit": "milliseconds",
      "duration_minimum": 0,
      "duration_maximum": 86400000
    },
    "action_receipts@1.0": {
      "intent_field": "avatar.intent.action_id",
      "receipt_route": "/action/result",
      "passive_gestures_without_receipts": ["idle", "talk"],
      "terminal_facts": ["completed", "rejected", "interrupted"],
      "storage": "bounded_session_memory",
      "grants_permission": false
    },
    "action_methods@1.0": {
      "session_capability_field": "session.start.supported_actions",
      "intent_fields": ["action_id", "method", "parameters", "transition", "source"],
      "selection": "server_client_intersection",
      "legacy_client_excludes": ["crouch"],
      "one_full_body_action_per_turn": true
    }
  },
  "base_path": "/api/v1/plugins/extensions/astrbot_plugin_embodiment_bridge",
  "authentication_headers": [
    "Authorization",
    "X-Embodiment-Bridge-Key"
  ],
  "legacy_authentication_headers": ["X-Quest-Avatar-Key"],
  "audio": {
    "input": {
      "format": "pcm16",
      "byte_order": "little_endian",
      "sample_rate": 16000,
      "channels": 1,
      "sample_width_bytes": 2,
      "recommended_chunk_ms": {"minimum": 40, "maximum": 100},
      "sequence_first": 0,
      "sequence_step": 1
    },
    "output": {
      "format": "pcm16",
      "byte_order": "little_endian",
      "sample_rate": 24000,
      "channels": 1,
      "sample_width_bytes": 2,
      "encoding": "base64_in_sse_data"
    }
  },
  "routes": [
    {"method": "GET", "path": "/pairing/service-status", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "POST", "path": "/pairing/service-control", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "POST", "path": "/pairing/listener-port", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "GET", "path": "/pairing/overview", "success_status": 200, "authentication": "astrbot_dashboard"},
      {"method": "GET", "path": "/pairing/operator-settings", "success_status": 200, "authentication": "astrbot_dashboard"},
      {"method": "POST", "path": "/pairing/operator-settings", "success_status": 200, "authentication": "astrbot_dashboard"},
      {"method": "GET", "path": "/pairing/fast-action-settings", "success_status": 200, "authentication": "astrbot_dashboard"},
      {"method": "POST", "path": "/pairing/fast-action-settings", "success_status": 200, "authentication": "astrbot_dashboard"},
      {"method": "GET", "path": "/pairing/stt-settings", "success_status": 200, "authentication": "astrbot_dashboard"},
      {"method": "POST", "path": "/pairing/stt-settings", "success_status": 200, "authentication": "astrbot_dashboard"},
      {"method": "GET", "path": "/pairing/platform-settings", "success_status": 200, "authentication": "astrbot_dashboard"},
      {"method": "POST", "path": "/pairing/platform-settings", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "GET", "path": "/pairing/persona-settings", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "POST", "path": "/pairing/persona-settings", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "GET", "path": "/pairing/persona-library", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "POST", "path": "/pairing/persona-converter-settings", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "POST", "path": "/pairing/persona-convert", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "POST", "path": "/pairing/persona-conversion-start", "success_status": 202, "authentication": "astrbot_dashboard"},
    {"method": "POST", "path": "/pairing/persona-conversion-status", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "POST", "path": "/pairing/persona-conversion-cancel", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "POST", "path": "/pairing/persona-profile-open", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "POST", "path": "/pairing/persona-profile-save", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "POST", "path": "/pairing/persona-profile-activate", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "POST", "path": "/pairing/persona-profile-delete", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "GET", "path": "/pairing/quest-identity-settings", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "POST", "path": "/pairing/quest-identity-settings", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "GET", "path": "/pairing/diagnostics", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "GET", "path": "/pairing/identity-candidates", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "POST", "path": "/pairing/identity-selection", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "GET", "path": "/pairing/api-principal-proof", "success_status": 200, "authentication": "astrbot_api_key_plugin_scope"},
    {"method": "POST", "path": "/pairing/create", "success_status": 201, "authentication": "astrbot_dashboard"},
    {"method": "POST", "path": "/pairing/status", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "POST", "path": "/pairing/revoke", "success_status": 200, "authentication": "astrbot_dashboard"},
    {"method": "POST", "path": "/pairing/exchange", "success_status": 200, "authentication": "builtin_listener_one_time_credential_or_astrbot_outer_auth+one_time_credential"},
    {"method": "POST", "path": "/session/start", "success_status": 201},
    {"method": "GET", "path": "/events/<session_id>", "success_status": 200},
    {"method": "POST", "path": "/turn/start", "success_status": 202},
    {"method": "POST", "path": "/audio/chunk", "success_status": 202},
    {"method": "POST", "path": "/audio/end", "success_status": 202},
    {"method": "POST", "path": "/interaction", "success_status": 202},
    {"method": "POST", "path": "/action/result", "success_status": 200},
    {"method": "POST", "path": "/interrupt", "success_status": 200},
    {"method": "POST", "path": "/session/close", "success_status": 200},
    {"method": "POST", "path": "/spatial/context", "success_status": 200},
    {"method": "GET", "path": "/health", "success_status": 200}
  ],
  "enums": {
    "emotion": [
      "neutral",
      "happy",
      "shy",
      "surprised",
      "concerned",
      "uncomfortable"
    ],
    "gesture": [
      "idle",
      "talk",
      "wave",
      "bow",
      "handshake",
      "head_pat",
      "cheek_pinch",
      "refuse",
      "step_back",
      "dance",
      "dance_next",
      "raise_hand",
      "turn_half",
      "sit",
      "lie",
      "nod",
      "sway",
      "crouch"
    ],
    "look_at": ["user", "hand", "away", "none"],
    "interaction_name": [
      "handshake",
      "head_pat",
      "cheek_pinch",
      "gaze",
      "speaking"
    ],
    "interaction_phase": ["start", "update", "end", "cancel"],
    "hand": ["left", "right", "both", "none"],
    "action_result_status": [
      "accepted",
      "started",
      "completed",
      "rejected",
      "interrupted"
    ],
    "action_result_reason": [
      "accepted",
      "started",
      "completed",
      "unsupported",
      "busy",
      "blocked",
      "tracking_lost",
      "asset_missing",
      "invalid_state",
      "superseded",
      "user_interrupted",
      "system_interrupted"
    ]
  },
  "event_order": {
    "speech_success": [
      "asr.final",
      "avatar.intent",
      "reply.text.delta",
      "reply.audio.chunk",
      "reply.end"
    ],
    "text_success": [
      "avatar.intent",
      "reply.text.delta",
      "reply.audio.chunk",
      "reply.end"
    ],
    "interaction_success": [
      "avatar.intent",
      "reply.text.delta",
      "reply.audio.chunk",
      "reply.end"
    ],
    "stt_unavailable": ["error"],
    "stt_failed": ["error"],
    "tts_failed_after_text": [
      "avatar.intent",
      "reply.text.delta",
      "error",
      "reply.end"
    ],
    "turn_failed": [
      "error",
      "reply.end"
    ],
    "interaction_failed": [
      "error",
      "reply.end"
    ]
  },
  "unity_conversation_controller": {
    "text_max_characters": 8192,
    "audio_turn_text_forms_accepted": ["omitted", "null", "empty_string"],
    "recommended_capture_chunk_ms": 80,
    "recommended_capture_chunk_bytes": 2560,
    "input_sequence_first": 0,
    "input_sequence_step": 1,
    "interrupt_before_new_turn": true,
    "stale_events_after_interrupt_ack": "discard_by_session_and_turn"
  },
  "critical_events": [
    "asr.final",
    "avatar.intent",
    "reply.audio.chunk",
    "reply.end",
    "error"
  ],
  "droppable_events": [
    "asr.partial",
    "reply.text.delta"
  ],
  "interrupt_semantics": {
    "forbidden_after_interrupt_ack": [
      "asr.partial",
      "asr.final",
      "reply.text.delta",
      "reply.audio.chunk",
      "avatar.intent",
      "reply.end",
      "error"
    ]
  },
  "backpressure_semantics": {
    "bounded_per_session_queue": true,
    "asr_partial_coalesced_per_turn": true,
    "droppable_when_full": [
      "asr.partial",
      "reply.text.delta"
    ],
    "never_dropped_to_admit_noncritical": [
      "asr.final",
      "avatar.intent",
      "reply.audio.chunk",
      "reply.end",
      "error"
    ],
    "critical_producer_waits_when_only_critical_events_remain": true
  },
  "reconnect_semantics": {
    "max_streams_per_session": 1,
    "last_event_id_replay": false,
    "already_consumed_events_replayed": false,
    "queued_unconsumed_critical_events_retained": true
  },
  "session_start_semantics": {
    "same_owner_and_identity_is_idempotent_and_reauthorized": true,
    "identity_change_for_existing_session_is_conflict": true,
    "protected_context_status_in_response": true,
    "protected_context_default_access": "denied",
    "api_principal_source": "astrbot_authenticated_request",
    "trusted_client_id_source": "bridge_server_config",
    "trusted_platform_id_source": "bridge_server_config",
    "unity_trusted_source_fields": false,
    "supported_actions_optional": true,
    "omitted_supported_actions_mode": "legacy"
  },
  "spatial_context_semantics": {
    "schema_version": 1,
    "storage": "session_memory_only",
    "revision": "strictly_increasing_or_identical_idempotent",
    "injection_scope": "authorized_embodiment_eventbus_turn_only",
    "contains_free_text": false,
    "contains_geometry_or_identifiers": false,
    "grants_permission": false
  },
  "action_result_semantics": {
    "server_generated_action_id": true,
    "transitions": {
      "planned": ["accepted", "rejected", "interrupted"],
      "accepted": ["started", "rejected", "interrupted"],
      "started": ["completed", "rejected", "interrupted"],
      "completed": [],
      "rejected": [],
      "interrupted": []
    },
    "exact_duplicate_is_idempotent": true,
    "changed_receipt_replay_is_conflict": true,
    "terminal_fact_injection_scope": "later_authorized_embodiment_eventbus_turns_only",
    "planned_is_fact": false,
    "grants_permission": false
  },
  "pairing_bootstrap_semantics": {
    "register_web_api_anonymous_supported": false,
    "page_create_authentication": "astrbot_dashboard",
    "builtin_listener_anonymous_exact_path_only": true,
    "astrbot_extensions_exchange_requires_outer_auth": true,
    "legacy_reverse_proxy_supported": true,
    "exchange_credential": "single_use_token_or_six_digit_code",
    "expected_remote_ip_bound_per_session": true,
    "per_source_rate_limit": true,
    "global_rate_limit": true,
    "private_http_requires_server_and_session_opt_in": true,
    "public_network_requires_https": true
  },
  "series_integration_semantics": {
    "knowledge_scope": "global_only",
    "relationship_requires_identity_authorization": true,
    "environment_mode": "cached_only",
    "voice_contract": "voice.audio_output@1.0",
    "runtime_refresh": "startup_and_explicit_health",
    "conversation_proactive_delivery_consumed": false,
    "orchestration_hub_resolver_consumed": false
  },
  "sse_error_codes": [
    "stt_empty",
    "stt_unavailable",
    "stt_failed",
    "astrbot_pipeline_not_woken",
    "astrbot_pipeline_event_stopped",
    "astrbot_pipeline_reply_capture_empty",
    "astrbot_pipeline_no_response",
    "astrbot_pipeline_empty_reply",
    "turn_failed",
    "interaction_failed",
    "tts_failed",
    "owner_not_configured",
    "quest_identity_not_allowlisted",
    "trusted_platform_not_configured"
  ],
  "http_error_codes": [
    {"status": 400, "code": "invalid_content_length"},
    {"status": 400, "code": "empty_body"},
    {"status": 400, "code": "invalid_audio"},
    {"status": 401, "code": "astrbot_auth_required"},
    {"status": 401, "code": "bridge_auth_failed"},
    {"status": 403, "code": "session_ownership_mismatch"},
    {"status": 404, "code": "session_not_found"},
    {"status": 409, "code": "session_conflict"},
    {"status": 409, "code": "action_receipt_replay"},
    {"status": 409, "code": "action_plan_stale"},
    {"status": 409, "code": "action_mismatch"},
    {"status": 409, "code": "action_transition_invalid"},
    {"status": 413, "code": "payload_too_large"},
    {"status": 415, "code": "unsupported_media_type"},
    {"status": 422, "code": "schema_validation_failed"},
    {"status": 500, "code": "internal_error"},
    {"status": 503, "code": "bridge_not_configured"}
    ,{"status": 503, "code": "bridge_service_disabled"}
  ]
}
